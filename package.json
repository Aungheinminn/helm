{
  "name": "helm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:agent": "bun run --filter agent dev",
    "dev:server": "bun run --filter server dev",
    "dev:remote": "bun run --filter remote dev",
    "build": "bun run --filter agent build && bun run --filter remote build",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "trustedDependencies": ["electron"]
}
